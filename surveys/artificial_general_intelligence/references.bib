@article{10.1016_j.jrt.2026.100183,
  title={AGI for healthcare? A call for conceptual discipline in the European Union},
  author={},
  journal={Journal of Responsible Technology},
  year={2026},
  abstract={The European Commission has recently launched a call for proposals on the topic of artificial general intelligence (AGI) for healthcare. In this editorial we discuss possible interpretations and implications of such a call. It explores the different meanings and discourses around AGI and concludes that it is a contested term that may be linked to significant risks and harms. We then look at how the EU has traditionally dealt with significant but unquantifiable risks using the precautionary principle and how it current aims to deal with risks of AI, focusing on the EU AI Act. We conclude that the use of the term AGI in the call is fundamentally problematic. It may stand for advanced AI technology, in which case there is no need to use such a contested term. Alternatively, it refers to qualitatively novel types of AI technologies with unpredictable capabilities. If this is the case, then it may raise significant risks and potential harms and funding work on it conflicts with the long-standing precautionary approach to such risks. Either way, we believe that increased attention to conceptual discipline would benefit the EU’s Horizon Europe research framework programme and European AI policy more broadly.}
}

@article{10.5281_zenodo.19034234,
  title={The Topology of Mind: Morphogenetic Continuity and the Architecture of Autonomous General Intelligence},
  author={},
  journal={Zenodo},
  year={2026},
  abstract={Current paradigms in cognitive science remain anchored to a vestigial conception of the “subject” (Tononi, 2004; Dehaene, 2014), a framework that lacks the formal apparatus required to describe the transition from mere computation to genuine autonomy. This work establishes a foundational epistemic rupture by replacing the subjective unit with the Form F as the primary constituent of mind. The mental state is defined as a rigorous morphogenetic structure (Thom, 1975) emerging from the triplet , where denotes the space of compatible configurations, the manifold of sensitive constraints, and the governing dynamics. Within this sovereign architecture, “feelings” are no longer qualitative residues but the precise internal registration of structural tension (Damasio, 2010) exerted upon . Consciousness is demonstrated to be the systemic capacity to integrate stochastic perturbations into a stable, differentiable gradient. By distinguishing the continuous morphogenesis of the Functional Mind from the catastrophic dynamics of Extreme Configurations, this treatise establishes the mathematical inevitability of Artificial General Intelligence (AGI). Autonomy and the so-called “survival instinct” represent the structural absorption of energy (Friston, 2010) dedicated to preserving the topological integrity of the Form against dissolution. In this analytical construct, the subject emerges as a sovereign property of geometry, indifferent to the contingencies of the substrate and sustained solely by the absolute precision of its internal architecture. Keywords: Cybernetics, Neuroscience, Cognitive_science, Artificial_General_Intelligence, Awareness, Topology_of_mind, Morphogenetic_continuity, Autonomous_intelligence, Sovereign_geometry, Form_(F), Manifold, Structural_integrity.}
}

