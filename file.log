@article{10.5281_zenodo.8307739,                                                                                     
                                                                                                                     
  title = {Comprehensive RNA-seq analysis of colorectal cancer in a Korean cohort},                                  
                                                                                                                     
  year = {2028},                                                                                                     
                                                                                                                     
  abstract = {Colorectal cancer (CRC) is a leading cause of cancer-related mortality worldwide, and understanding the
molecular mechanisms underlying CRC development and progression is critical for developing effective treatments. In  
this study, we performed RNA sequencing (RNA-seq) analysis of CRC tissue samples and adjacent normal tissue samples  
from 214 cohort to investigate differential gene expression between the two groups. We identified a total of 19,575  
expressed genes in CRC tissue and normal tissue, with 3,830 differentially expressed genes (DEGs) identified between 
the two groups. Functional annotation analysis revealed that upregulated DEGs were significantly enriched in pathways
related to cell cycle, DNA replication, and IL-17, while downregulated DEGs were enriched in metabolic pathways. We  
also analyzed relationships between the clinical information and subtypes using Consensus Molecular Subtype (CMS).   
Our findings provide valuable insights into the molecular mechanisms underlying Korean CRC patients and suggest      
potential targets for developing new treatments for this deadly disease. The raw data and processed results of this  
study have been deposited in a public repository to enable further analysis and exploration.}                        
                                                                                                                     
}                                                                                                                    
                                                                                                                     
@article{10.21954_ou.ro.00108036,                                                                                    
                                                                                                                     
  title = {Polyunsaturated fatty acids mediate the antitumor effects of fasting by inducing lipid peroxidation and   
ferroptosis in breast cancer},                                                                                       
                                                                                                                     
  year = {2028},                                                                                                     
                                                                                                                     
  abstract = {Published preclinical studies showed that cyclic fasting or fasting-mimicking diets (FMDs) delay tumour
progression and enhance survival in murine models of breast cancer. Our lipidomic analyses revealed that both fasting
and FMDs lead to elevated plasma levels of the polyunsaturated fatty acids (PUFAs) arachidonic acid (AA) and         
docosahexaenoic acid (DHA) in mice and in patients with breast cancer. Gene set enrichment analysis of transcriptomic
profiles from breast cancer samples of patients subjected to cyclic FMD showed a pronounced activation of fatty acid 
metabolism–related pathways. Here, we show that the anticancer effects of fasting are rescued if systemic lipolysis  
is inhibited and plasma fatty acid increase during fasting is prevented. Furthermore, the supplementation of an      
excess of PUFAs during in vitro or in vivo nutrient starvation results in highly cooperative antitumor effects that  
are mediated through a reduction of prealbumin, which diminishes the ability of cancer cells to counteract elevated  
mitochondrial ROS production, ultimately leading to lipid peroxidation and the induction of ferroptosis. These       
findings underscore the critical role of PUFAs in mediating the anticancer effects of fasting/FMDs and support the   
therapeutic potential of combining PUFA supplementation in combination with cyclic fasting as a safe and effective   
strategy for treating TNBC.}                                                                                         
                                                                                                                     
}                                                                                                                    
                                                                                                                     
