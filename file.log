+  title={A New Approach in Quantum Cryptography for Enhancing Data Security},                                       
+  author={},                                                                                                        
+  year={2025},                                                                                                      
+  abstract={This thesis provides a comprehensive overview of quantum cryptography, detailing principles of quantum  
key distribution protocols such as BB84, B92, and B91. It compares these protocols and analyzes Shor's algorithm,    
including its steps, quantum implementation, and execution on quantum computers. Furthermore, it examines security   
threats including Photon Splitting Attacks, Faked-State Attacks, and Trojan-Horse Attacks, offering countermeasures  
and future perspectives for secure quantum communication.}                                                           
+}                                                                                                                   
+                                                                                                                    
+@article{10.31695_ijerat.2025.9.1,                                                                                  
+  title={QUANTUMINTERNET},                                                                                          
+  author={},                                                                                                        
+  year={2025},                                                                                                      
+  abstract={Today’s Internet is a global communications network used to transfer, process, and store classical      
information. The quantum Internet is a hypothetical high-speed Internet that provides ultra-secure connectivity to   
quantum devices across the globe. It is a network of quantum computers that will someday send, compute, and receive  
information encoded in quantum states. It is a communications network that will transform industries, increase       
security, and alter the way we transmit information. While quantum computers exist in the physical world, the concept
of quantum Internet is currently theoretical. In its infant form, the quantum Internet promises to make the digital  
domain safer, more productive, and more powerful than ever before. In this study, we provide a primer on quantum     
Internet, which provides a large-scale application of advanced quantum communication technologies and protocols.}    
+}                                                                                                                   
+                                                                                                                    
+@article{10.11159_icffts23.133,                                                                                     
+  title={Quantum Computing CFD Simulations for Aeronautical Heat Exchangers},                                       
+  author={},                                                                                                        
+  year={2023},                                                                                                      
+  abstract={This document reviews and discusses the possible applications of Quantum computing to computational     
fluid dynamics (CFD) problems. A review of the current state-of-the-art of quantum computing applied to computational
fluid dynamics has been carried out, highlighting how the technology is still in an early stage of development but   
very promising. Possible approaches applicable to compact heat exchangers used in aeronautics include the development
of quantum algorithms based on the solutions of Navier Stokes equations or the Lattice Boltzmann Method, the design  
of an analog quantum computer able to mimic the thermal fluid system under investigation, and the implementation of a
scientific machine learning approach.}                                                                               
+}                                                                                                                   
+                                                                                                                    
+@article{10.21741_9781644902813-38,                                                                                 
+  title={Quantum computing CFD simulations: state of the art},                                                      
+  author={},                                                                                                        
+  year={2023},                                                                                                      
+  abstract={This document reviews and discusses the possible applications of Quantum computing in the area of       
computational fluid dynamics (CFD). A review of the current state-of-the-art of quantum computing applied to         
computational fluid dynamics has been carried out, highlighting how the technology is promising but still in an early
stage of development. Furthermore, within the approaches developed to solve CFD problems with the use of quantum     
algorithms and/or quantum computers, this article discusses a quantum algorithm approach based on the Lattice        
Boltzmann Method and developed to the study of 2D flow around a cylinder, a model which can be related to several    
industrial problems and, in the future, modified to simulate the refrigeration cycle used in aeronautical            
environmental control systems (ECS).}                                                                                
+}                                                                                                                   
+                                                                                                                    
+@article{10.1063_5.0151346,                                                                                         
+  title={Quantum computing and materials science: A practical guide to applying quantum annealing to the            
configurational analysis of materials},                                                                              
+  author={},                                                                                                        
+  year={2023},                                                                                                      
+  abstract={Using quantum computers for computational chemistry and materials science will enable us to tackle      
problems that are intractable on classical computers. In this paper, we show how the relative energy of defective    
graphene structures can be calculated by using a quantum annealer. This simple system is used to guide the reader    
through the steps needed to translate a chemical structure (a set of atoms) and energy model to a representation that
can be implemented on quantum annealers (a set of qubits). We discuss in detail how different energy contributions   
can be included in the model and what their effect is on the final result. The code used to run the simulation on    
D-Wave quantum annealers is made available as a Jupyter Notebook. This Tutorial was designed to be a quick-start     
guide for the computational chemists interested in running their first quantum annealing simulations.}               
+}                                                                                                                   
