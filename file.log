people.}                                                                                                             
+}                                                                                                                   
+@article{10.48617_etd.1645,                                                                                         
+  title = {Directed Evolution of Multivalent 2'-Modified RNA Towards Protein Targets},                              
+  year = {2031},                                                                                                    
+  abstract = {Carbohydrate binding proteins (CBPs) are alluring and challenging targets in biology. CBPs achieve    
high-affinity interactions with their substrates through multivalent interactions with carbohydrates, often in       
branched, heterogeneous structures. Many cell recognition events and host-pathogen interactions are mediated by these
carbohydrate-protein interactions. Therefore, the development of glycan-based mimics and disruptors of these         
interactions have applications in studying target CBPs, carbohydrate-based vaccines, immunomodulating agents,        
diagnostics, and therapeutics against cancer and other diseases. Previously, the Krauss lab has developed SELection  
with Modified Aptamers (SELMA), to evolve nucleic acid-scaffolded glycan clusters to develop high-affinity aptamers  
towards CBPs. Herein, I describe the extension of Hairpin-SELMA to fully 2\u2032-modified RNA scaffolds, which confer
enhanced serum stability, using engineered polymerases (KOD-DGLNK, SFM4-3, and Therminator).}                        
+}                                                                                                                   
+@article{10.17638_03195029,                                                                                         
+  title = {Dynamic Mitochondrial Protein Succinylation Induced by Nutritional Intervention with Omega-3             
Polyunsaturated Fatty Acids Elicits Growth Inhibition and Lethality in Prostate Cancer Cells},                       
+  year = {2031},                                                                                                    
+  abstract = {Prostate cancer (PCa) continues to present a significant therapeutic challenge due to its metabolic   
plasticity and resistance to conventional treatments. Although omega-3 fatty acids, especially high-purity           
eicosapentaenoic acid (EPA), have demonstrated anticancer properties, the underlying molecular mechanisms remain     
inadequately understood. In this study, we provide evidence that EPA induces potent growth inhibition in PCa cells by
modulating a mitochondrial succinylation network, thereby revealing three interconnected nodes of metabolic          
vulnerability. Through succinylomic profiling and functional validation, we identified SDHA, GOT2, and DAP3 as       
critical EPA-induced succinylation targets. Mechanistically, SDHA succinylation induces succinate accumulation and   
promotes widespread succinylation across mitochondrial proteins, thereby disrupting the homeostasis of mitochondria. 
This mitochondrial dysfunction converges on two lethal pathways in PCa cells: first, GOT2 hyper-succinylation        
inhibits aspartate biosynthesis, depleting dNTP pools and thereby stalling DNA replication; second, the function     
change in DAP3 may fail to save cell from ferroptosis. Here, by investigating the succinylome profiling following EPA
nutritional interventions and the consequent changes in specific mitochondrial proteins, this study aims to establish
a theoretical foundation for future innovative therapeutic drug design.}                                             
+}                                                                                                                   
+@article{10.17638_03193849,                                                                                         
+  title = {DUB regulators of YAP/TAZ activity in mesothelioma and head and neck cancer},                            
+  year = {2031},                                                                                                    
+  abstract = {The Hippo pathway is evolutionarily conserved to regulate multiple biological processes including     
development, organ size, apoptosis, and tissue regeneration, thereby maintaining tissue homeostasis. This            
tumour-suppressive signalling cascade acts inactivates the downstream effectors and oncogenes YAP/TAZ, preventing    
their binding to the TEAD transcription factors. Disruption of the Hippo pathway and aberrant YAP/TAZ activity are   
observed in many cancers such as pleural mesothelioma (PM) and head and neck squamous cell carcinoma (HNSCC), where  
there are known genetic drivers. Deubiquitinating enzymes (DUBs) have been identified as direct or indirect          
regulators of the pathway. However, questions remain unresolved, notably around the specificity of their interaction 
with the Hippo components which may depend on the cancer type and/or genetic background. To uncover novel roles for  
DUBs in malignancies with YAP/TAZ aberrant activation, the regulation of these oncogenes in PM and HNSCC was         
investigated by two complementary, unbiased DUB siRNA library screens in cells with hyper-active YAP/TAZ. Among a    
panel of 24 cell lines, the PM NCI-H2052 and HNSCC PE/CA-PJ41 exhibited highly expressed or hyper-activated YAP      
coupled with robust TEAD transcriptional activity and were selected as appropriate cell models for DUB siRNA screen. 
Method development included two main readouts: (i) a TEAD-specific dual luciferase assay to measure the output of the
Hippo pathway upon silencing of 94 human DUBs; (ii) real-time monitoring of cell confluency to examine cell viability
upon DUB silencing. Data revealed different top DUB hits in each cell line, whose depletion strongly reduced TEAD    
activity, representing potential therapeutic targets. Majority of the six best performing DUB hits in each cancer    
model were not previously associated with the Hippo pathway or these malignancies. DUBs regulators of YAP/TAZ in     
HNSCC were further explored in a complementary project in our group. In PM, USP42 emerged as the strongest candidate 
compared to the others when followed up across multiple analyses. USP42 over-expression is associated with lower     
survival in mesothelioma. Its depletion significantly decreased TEAD activity, and it also affected cell             
proliferation and YAP(Ser127)/TAZ(Ser89) phosphorylation in NCI-H2052. Moreover, an unreported USP42 interaction with
Hippo components was highlighted in HEK293, where USP42 levels also influenced their protein expression, suggesting  
its role in modulating the Hippo signalling, and hence YAP/TAZ-TEAD activity in cancer. To explore the underlying    
molecular mechanism, USP42 knockout MCF 10A clones were generated but proved impossible to grow, indicating USP42    
essentiality. In future, an inducible shUSP42 system, that was developed in this work, will allow a time-controlled  
depletion for more in-depth analysis. Overall, the findings uncovered cell/cancer-specific DUB candidates linked with
YAP/TAZ oncogenic behaviour in HNSCC or PM, strengthening the hypothesis that roles for different DUBs in            
cancer-associated Hippo signalling may emerge in specific cancer types. USP42 was identified as the most promising   
DUB candidate to regulate YAP/TAZ activity in PM. Additional validation may unveil its therapeutic potential in      
cancers with disrupted Hippo signalling and YAP/TAZ aberrant activation.}                                            
+}                                                                                                                   
+@article{10.5526_err-00042862,                                                                                      
+  title = {Landscape of nucleosome repositioning in glioblastoma multiforme},                                       
+  year = {2031},                                                                                                    
+  abstract = {Glioblastoma (GBM) is classified as a grade IV astrocytoma, characterised by its aggressive nature and
poor prognosis. It represents a major problem in oncology given its abysmal survival rate and lack of effective      
treatment options to cure the malignancy and prevent relapses. The current methods for diagnostics generally include 
magnetic resonance imaging (MRI) followed by histopathological confirmation via analysis of tissue biopsy, which is  
an invasive method. Furthermore, such diagnostics methods often result in brain cancer detection at late stages. One 
alternative method is liquid biopsy, which uses bodily fluids, e.g. blood plasma or cerebral spinal fluid (CSF), to  
extract and analyse cell-free DNA (cfDNA) to detect genomic or epigenomic alterations characteristic of the disease. 
The aim of this project was to analyse a specific type of change in cfDNA reflecting nucleosome positioning in the   
cells of origin, which may be used for GBM diagnostics. Using data from a cohort of 10 GBM patients, I have analysed 
nucleosome positioning in paired normal/tumour brain tissues and the corresponding cfDNA. I compared nucleosome      
profiles from these three sources around binding sites of transcription factors (TFs) and developed new ways of data 
normalisation and visualisation with heatmaps and clustering. This work provided a shortlist of TFs that can be used 
as biomarkers and highlighted the challenges encountered in liquid biopsies of GBM and suggested new approaches to   
overcome these.}                                                                                                     
+}                                                                                                                   
+@article{10.5526_err-00042900,                                                                                      
+  title = {Analysis of cell-free DNA for cancer diagnostics using liquid biopsies},                                 
+  year = {2031},                                                                                                    
+  abstract = {Chromatin organisation influences gene regulation and genome stability, yet its dysregulation in      
cancer remains incompletely understood. This has become particularly important for patient diagnostics using         
cell-free DNA (cfDNA) from body fluids, based on computational analyses of nucleosome occupancy landscapes           
reconstructed from cfDNA. This thesis establishes the first comprehensive atlas of nucleosome positioning signatures 
across repetitive elements in tumour tissues and cfDNA. Using original approaches to cfDNA analysis, I demonstrate   
that genomic repetitive elements, including satellite repeats, LINEs, SINEs, and LTRs, undergo reproducible family-, 
subfamily-, and tissue-specific nucleosome repositioning in cancer. Integration with DNA methylation profiling       
reveals coordinated changes in methylation and nucleosome positioning at specific genomic repeats, underscoring the  
epigenetic interplay that drives chromatin instability. Quantifying cfDNA profiles at DNA sequence repeats, including
unmappable genomic regions, identified highly informative cfDNA signatures. Machine learning models trained on these 
cfDNA repeat features successfully discriminated healthy individuals from patients with colorectal, pancreatic, bile 
lung, and gastric cancer, achieving robust performance even when minimal sets of repeated elements were used as top  
features. My analyses showed that nucleosome signatures at genomic repeats vary substantially across cfDNA           
fragment-size fractions, offering both pan-cancer and tissue-specific diagnostic insights. Additional                
nucleosomics-based approaches were benchmarked in glioblastoma (GBM). Using differential nucleosome occupancy in     
paired GBM and normal brain tissues, repeat-based cfDNA profiling achieved high accuracy and clearly distinguished   
patients from healthy controls. Combined analyses revealed that nucleosome organisation of repetitive elements in    
cfDNA mirrors tumour-specific chromatin reprogramming, providing a non-invasive readout of disease state. Together,  
these findings highlight the repetitive genome as a structured, regulatory, and clinically tractable layer of cancer 
epigenetics, establishing a conceptual and methodological foundation for repeat-based cfDNA diagnostics for early    
cancer detection and patient stratification.}                                                                        
+}                                                                                                                   
+@article{10.17638_03194520,                                                                                         
+  title = {Tumor-promoting roles of the chromatin-associated DEK oncogene in metastatic melanoma},                  
+  year = {2029},                                                                                                    
+  abstract = {As a multifunctional, conserved yet unique non-histone chromatin-architectural factor, the DEK        
oncoprotein is known to be involved in multiple nuclear processes, including chromatin remodeling, transcriptional   
regulation, and DNA damage response. Although aberrant DEK expression has been identified in various cancers, its    
precise mechanistic contribution to tumorigenesis remains incompletely understood. This includes its genome-wide     
chromatin binding patterns in cancer cells and how this affects chromatin structure and cellular functions.          
Therefore, the aim of this thesis is to investigate the chromatin binding landscape and functional role of DEK in    
chromatin organization and transcriptional regulation with a particular focus on phosphorylation-dependent modulation
by the casein kinase 2 (CK2) in cancer cells, particularly melanoma cell lines. Using chromatin immunoprecipitation  
followed by next-generation sequencing (ChIP-seq), we first mapped the genome-wide DEK occupancy in HeLa S3 cells and
identified DEK binding sites enriched at transcriptionally active genomic regions. Integrative analyses using gene   
expression microarray and ATAC-seq data sets revealed that DEK knockout led to extensive chromatin accessibility     
changes and transcriptional reprogramming, including the upregulation of genes involved in melanogenesis and tumor   
suppression. Notably, DEK functions both as a transcriptional repressor and activator in a context-dependent manner, 
modulating gene expression through direct promoter binding and distal chromatin interactions. Further comparative    
profiling in primary melanocytes and several melanoma cell lines revealed distinct cell-type-specific DEK binding    
patterns between non-tumorigenic and malignant cells, suggesting a role in oncogenic chromatin reprogramming. In     
addition, epigenomic characterization showed that melanoma subtypes with different mutations exhibited divergent     
histone modification landscapes, particularly in the distribution of the active enhancer mark H3K27ac. To explore the
role of phosphorylation in regulating DEK, the CK2 inhibitor CX-4945 (Silmitasertib) was used in SK-Mel-103 melanoma 
cells. Combined ChIP-seq and LC-MS/MS analyses showed that CX-4945 reduced overall cellular phosphorylation level,   
and specifically, sites mapped to serine 287 / 288 in DEK in SK-Mel-103 cells. DEK binding was redistributed across  
chromatin, with altered gene expression patterns and increased association at regions marked by the repressive       
histone modification H3K9me3. These changes correlated with elevated chromatin compaction and increased nuclear and  
cytoplasmic DEK accumulation. These effects were further validated through DEK knockdown experiments, which          
attenuated CX-4945-induced chromatin compaction and transcriptional repression. Collectively, these findings         
highlight DEK as a dynamic chromatin architectural protein regulated by phosphorylation and cellular context. By     
delineating its role in chromatin remodeling, gene regulation, and melanoma progression, this work provides new      
insights into the mechanisms by which DEK contributes to chromatin regulation and melanoma progression and           
establishes a foundation for potential therapeutic targeting of the DEK-CK2 regulatory pathway in cancer.}           
+}                                                                                                                   
+@article{10.48617_etd.1513,                                                                                         
+  title = {Iron-Catalyzed Stereoselective Glycosylation for Rapid Synthesis of Mucin-Type O-Linked Glycopeptide Core
Structures 1 and 2},                                                                                                 
+  year = {2029},                                                                                                    
+  abstract = {Mucin-type glycopeptides and glycoproteins are the most prevalent type of O-linked glycosylation in   
eukaryotes. Many forms of cancer aberrantly express mucin-type glycopeptides and glycoproteins such as Tn-antigens   
and MUC1. These glycoconjugates have been extensively explored as viable biomarkers and therapeutic targets for CAR-T
cell therapy and cancer vaccines. Due to the specific and selective nature of these therapies, a homogenous source of
mucin-type glycopeptides and glycoproteins is required. Homogenous isolation of these compounds from natural sources 
is difficult due to their ubiquitous and complex expression across most epithelial cells. This positions chemical and
enzymatic synthetic methods as powerful tools to access homogenous samples of mucin-type glycopeptides and           
glycoproteins. Mucin-type glycopeptides and glycoproteins are linked through a serine or threonine residue to a      
N-acetylgalactosamine glycan in a 1,2-cis-\u0251 manner. Through this common motif, 8 oligosaccharide core structures
are derived that confer functionality. Previous synthetic methods have utilized chemoenzymatic approaches to         
synthesize and diversify these glycans with most glycosylations performed via Lewis-acid assisted activation. These  
established methods are inefficient as they do not guarantee complete stereochemical control and require             
stoichiometric amounts of reagents. Our group has developed several highly stereoselective iron-catalyzed            
glycosylation reactions. These reactions can achieve high stereoselectivity in excellent yield across a wide range of
donor and acceptor combinations. Through the application of our iron-catalyzed glycosylations, a rapid and highly    
stereoselective synthesis of mucin-type core structures 1 and 2 was achieved.}                                       
+}                                                                                                                   
